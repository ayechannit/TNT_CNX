PORT=4000

# Postgres/Supabase connection for this deployment (Myanmar / TNTV1).
# Use a dedicated Supabase project for this deployment - keep it separate
# from the Chiang Mai (TNTV1_CNX) project.
DATABASE_URL=postgresql://postgres:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres

# Signs login session tokens - keep this secret and out of version control.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=CHANGE_ME
